# GEMINI_API_KEY: Fallback & direct AI generation
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI MODEL CONFIGURATION (Set in Render Secrets / Environment Variables)
# Supported keys: MODEL_ID, GEMINI_MODEL, or MODEL
# Recommended models: "gemini-3.7-flash", "gemini-3.1-pro-preview", "gpt-4o-mini", etc.
MODEL_ID="gemini-3.7-flash"
GEMINI_MODEL="gemini-3.7-flash"

# GOOGLE OAUTH 2.0 CONFIGURATION (For Direct Google Sign-In & Verification)
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""

# APP & BACKEND URLS (For Vercel Frontend <-> Render Backend)
APP_URL="http://localhost:3000"
VITE_BACKEND_URL=""

# DEFAULT USER AI CREDITS (Allocated automatically to new registered users)
DEFAULT_AI_CREDITS="50"

# SESSION & SECURITY
SESSION_SECRET=""

# AICREDITS_API_KEY: API Key from https://aicredits.in/dashboard
AICREDITS_API_KEY=""
AICREDITS_BASE_URL="https://api.aicredits.in/v1"

# AICREDITS_VISION_MODEL: Cheapest vision-capable model (e.g., "gemini-1.5-flash" or "gpt-4o-mini")
AICREDITS_VISION_MODEL="gemini-1.5-flash"

# MEMO_API_KEY: Memo API Key for persistent AI user memory
MEMO_API_KEY=""
MEMO_API_URL="https://api.mem0.ai/v1"

# ADMIN_PASSWORD: Secure Admin Panel password (set as Render Secret / Environment variable)
ADMIN_PASSWORD="leo_admin_secret_pass"

# MONGODB_URI: MongoDB connection string (e.g., mongodb+srv://...)
MONGODB_URI=""

# FIREBASE CONFIGURATION (For Google Auth & Realtime Database)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_URL=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# EMAIL & SMTP CONFIGURATION (For Real OTP Delivery to User's Inbox)
# If using Gmail:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=465 (or 587)
#   SMTP_SECURE=true
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASS="xxxx xxxx xxxx xxxx" (16-character Google App Password from https://myaccount.google.com/apppasswords)
#   SMTP_FROM="Leo AI Security <your-email@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Leo AI Security <auth@leoai.app>"

# ALTERNATIVE HTTPS EMAIL APIS (Recommended for Firebase Cloud Functions / Serverless to bypass port 587 blocks)
RESEND_API_KEY=""
SENDGRID_API_KEY=""

