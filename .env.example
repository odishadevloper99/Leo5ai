# GEMINI_API_KEY: Fallback & direct AI generation
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI MODEL ROUTING CONFIGURATION (Set in Render Secrets / Environment Variables)
# 1. DEFAULT MODEL: Primary model for normal text conversation, writing, and explanations
DEFAULT_AI_MODEL="google/gemini-2.0-flash"

# 2. VISION MODEL: Multimodal model for photos, screenshots, and visual reasoning
VISION_AI_MODEL="google/gemini-2.0-flash"

# 3. CODE MODEL: Technical model for programming, code debugging, and software architecture
CODE_AI_MODEL="deepseek/deepseek-chat"

# Legacy / Alternative model aliases (backwards compatible)
MODEL_ID="google/gemini-2.0-flash"
GEMINI_MODEL="google/gemini-2.0-flash"

# APP & BACKEND URLS (For Vercel Frontend <-> Render Backend)
APP_URL="http://localhost:3000"
VITE_BACKEND_URL=""

# DEFAULT USER AI CREDITS (Allocated automatically to new registered users)
DEFAULT_AI_CREDITS="50"

# DAILY_MESSAGE_LIMIT: Max /api/chat messages per user per day. 0 or unset = unlimited.
# Also editable live from the Admin Panel -> AI Models tab.
DAILY_MESSAGE_LIMIT="0"

# TAVILY_API_KEY: Tavily Search API Key for autonomous AI web browsing (https://tavily.com)
TAVILY_API_KEY=""

# SESSION & SECURITY
SESSION_SECRET=""

# AICREDITS_API_KEY: API Key from https://aicredits.in/dashboard (PRIMARY provider)
AICREDITS_API_KEY=""
AICREDITS_BASE_URL="https://api.aicredits.in/v1"
# AICREDITS_MODEL: the exact model id your AICredits account should use for
# chat completions (e.g. "gpt-4o-mini"). If unset, falls back to MODEL_ID/
# GEMINI_MODEL/etc, which is usually WRONG for an OpenAI-compatible provider.
AICREDITS_MODEL=""

# AICREDITS_VISION_MODEL: Cheapest vision-capable model (e.g., "gemini-1.5-flash" or "gpt-4o-mini")
AICREDITS_VISION_MODEL="gemini-1.5-flash"

# MEMO_API_KEY: Memo API Key for persistent AI user memory
MEMO_API_KEY=""
MEMO_API_URL="https://api.mem0.ai/v1"

# ADMIN_PASSWORD: Secure Admin Panel password (set as Render Secret / Environment variable)
ADMIN_PASSWORD="leo_admin_secret_pass"

# MONGODB_URI: MongoDB connection string (e.g., mongodb+srv://...)
MONGODB_URI=""

# FIREBASE CONFIGURATION (For Google Auth & Realtime Database)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_URL=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# EMAIL & SMTP CONFIGURATION (For Real OTP Delivery to User's Inbox)
# If using Gmail:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=465 (or 587)
#   SMTP_SECURE=true
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASS="xxxx xxxx xxxx xxxx" (16-character Google App Password from https://myaccount.google.com/apppasswords)
#   SMTP_FROM="Leo AI Security <your-email@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Leo AI Security <auth@leoai.app>"

# ALTERNATIVE HTTPS EMAIL APIS (Recommended for Firebase Cloud Functions / Serverless to bypass port 587 blocks)
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# ADDITIONAL INTEGRATION SECRETS
JINA_API_KEY=""
DAYTONA_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
TRIGGER_PROJECT_ID=""
TRIGGER_SECRET_KEY=""
ADMIN_SESSION_SECRET=""
