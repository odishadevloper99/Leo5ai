# Leo AI — FRONTEND environment variables (Vercel / Vite build)
#
# This file is for the frontend only (deployed on Vercel). Backend secrets
# (Gemini/AI keys, SMTP, admin password, etc.) live in backend/.env.example
# and are configured on the Render service instead — do not put them here,
# since anything prefixed VITE_ is bundled into the client-side JS and is
# publicly visible in the browser.

# VITE_BACKEND_URL: the live URL of your deployed Render backend service,
# e.g. "https://leo-ai-backend.onrender.com" (no trailing slash needed).
# Every frontend API call in src/lib/api.ts is prefixed with this value.
VITE_BACKEND_URL=""

# FIREBASE CONFIGURATION (Client SDK — Auth, Firestore, Realtime Database)
# If left unset, the app falls back to the values in firebase-applet-config.json.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""
